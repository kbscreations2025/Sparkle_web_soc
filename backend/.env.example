PORT=4000
NODE_ENV=development

# Centralized login
LOGIN_API_BASE_URL=https://centralized-login-backend.onrender.com
CLIENT_ID=replace-with-this-apps-client-id
CLIENT_SECRET=ask-your-superadmin-for-this

# This app's `code` in the central login's permissioned_applications list
# (e.g. SELECT, CLARITY). Blank falls back to the central top-level role.
CENTRAL_APP_CODE=

# This app's id in the central login. Used by GET /apps/<id>/users to list
# everyone who has been granted access to Sparkle.
CENTRAL_APP_ID=ask-your-superadmin-for-this

# Where the Next.js frontend runs, for CORS
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB. NEVER put a real connection string in this file — it is committed.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=sparkle1

# REDIS / JOB QUEUE ================================
# Local: `docker compose up -d redis` from the repo root serves this default.
# Render: use the Key Value store's INTERNAL url (redis://…) when the service
# runs in the same region, or the external rediss:// url from anywhere else.
REDIS_URL=redis://127.0.0.1:6379

# One shared queue for every tool. Change only to isolate environments that
# share a Redis instance (e.g. staging vs production on one Key Value store).
QUEUE_NAME=sparkle-jobs

# How many generations one worker runs at once. Raise only as far as the AI
# provider keys tolerate before rate-limiting.
WORKER_CONCURRENCY=3

# Outer retry count per job, on top of the per-key retry/failover the provider
# modules already do.
JOB_ATTEMPTS=2

# Must stay above the slowest legitimate run (150s provider timeout + uploads),
# or a slow-but-healthy job gets picked up twice.
JOB_LOCK_DURATION_MS=300000

# Unset: the worker runs inside the API process in development and separately
# in production. Set "false" on the web service and "true" on the worker
# service to be explicit.
# RUN_WORKER_IN_PROCESS=

# Key-encryption keys for tenant AI provider credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add AI_KEK_V2, point AI_KEK_ACTIVE_VERSION at it, keep V1 for decrypting old rows.
AI_KEK_V1=replace-with-32-random-bytes-base64
AI_KEK_ACTIVE_VERSION=1

# Server pepper for key fingerprints. Changing this invalidates every stored
# fingerprint (duplicate-key detection), but does not affect decryption.
AI_KEY_FINGERPRINT_PEPPER=replace-with-a-long-random-string

# CLOUDFLARE R2 (image storage) ====================
# `select-images` is a bucket shared with other apps — this app writes only
# under the sparkle1/ prefix inside it (see backend/src/storage/r2.js).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=select-images
R2_PUBLIC_URL=
