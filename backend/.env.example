PORT=4000
NODE_ENV=development

# Centralized login
LOGIN_API_BASE_URL=https://centralized-login-backend.onrender.com
CLIENT_ID=replace-with-this-apps-client-id
CLIENT_SECRET=ask-your-superadmin-for-this

# Where the Next.js frontend runs, for CORS
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://kbssoft_db_user:gU8p84lGsHxAJBjv@cluster0.3pftvja.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=sparkle1

# Key-encryption keys for tenant AI provider credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add AI_KEK_V2, point AI_KEK_ACTIVE_VERSION at it, keep V1 for decrypting old rows.
AI_KEK_V1=replace-with-32-random-bytes-base64
AI_KEK_ACTIVE_VERSION=1

# Server pepper for key fingerprints. Changing this invalidates every stored
# fingerprint (duplicate-key detection), but does not affect decryption.
AI_KEY_FINGERPRINT_PEPPER=replace-with-a-long-random-string
